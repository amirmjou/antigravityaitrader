# ==============================================================================
# Arbitrum Autonomous Trading Bot — Environment Configuration Template
# ==============================================================================

# Private key of dedicated trading hot wallet (0x-prefixed, 64-hex chars)
TRADING_HOT_WALLET_KEY=0xYOUR_HOT_WALLET_PRIVATE_KEY_HERE

# Arbiscan API V2 Developer Token (from https://arbiscan.io/myapikey)
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY_HERE

# Telegram Bot Credentials (from @BotFather and @userinfobot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Execution security mode (production / development)
TRADINGAGENTS_SECURITY_MODE=production
